# 主搜索：学术论文 API
# Options: academic | semantic_scholar | openalex | tavily | duckduckgo | perplexity | searxng
SEARCH_API=academic

# Semantic Scholar（可选 API Key，提高速率）
# SEMANTIC_SCHOLAR_API_KEY=

# OpenAlex polite pool
OPENALEX_MAILTO=your-email@example.com

ACADEMIC_MAX_RESULTS=10
ACADEMIC_INCLUDE_CITING=true
ACADEMIC_CITING_LIMIT=5

# 可选网页补充（非主源）
ENABLE_WEB_SEARCH_SUPPLEMENT=false
# TAVILY_API_KEY=tvly-xxxxx

# LLM配置
LLM_PROVIDER=custom
LLM_MODEL_ID=your-model-name
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=your-api-base-url
LLM_TIMEOUT=60

HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000
LOG_LEVEL=INFO

MAX_WEB_RESEARCH_LOOPS=3
FETCH_FULL_PAGE=True
